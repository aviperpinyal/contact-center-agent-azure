# Copy to .env and fill in your values. Never commit .env.

# Microsoft Foundry project endpoint (az cognitiveservices account project show ... --query 'properties.endpoints."AI Foundry API"')
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
# Chat model deployment name
FOUNDRY_MODEL=gpt-5.4-mini

# Azure AI Search
SEARCH_ENDPOINT=https://<search-service>.search.windows.net

# Used by scripts/setup_knowledge_base.py
EMBED_MODEL=text-embedding-3-small
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
