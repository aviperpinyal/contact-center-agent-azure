{
  // Name shown in VS Code and on github.com/codespaces
  "name": "Contact Center Agent (Azure)",

  // Base image: Microsoft's maintained Python 3.12 dev container on Debian Linux
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // Features: add-on tools installed on top of the base image
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  // VS Code extensions installed automatically in the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.azure-dev"
      ]
    }
  }
}